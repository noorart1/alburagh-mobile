<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Required on Android 13+ (API 33) to show notifications at all;
         FirebaseMessaging.requestPermission() in push_notifications.dart
         triggers the runtime prompt for this. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <application
        android:label="البراق للأطفال"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- Flutter 3.24+'s own built-in deep-link auto-routing would
                 otherwise compete with app_links (deep_link_service.dart)
                 for the order-received intent-filter below; this hands that
                 URI to app_links exclusively instead. -->
            <meta-data
                android:name="flutter_deeplinking_enabled"
                android:value="false" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- WooCommerce checkout "return to app" hop: the Custom Tab
                 opened for checkout (see cart_screen.dart) navigates here on
                 successful order placement. autoVerify requires
                 https://www.alburagh.com/.well-known/assetlinks.json to be
                 published server-side; until then Android treats this as an
                 unverified link and won't hand it to the app automatically. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data
                    android:scheme="https"
                    android:host="www.alburagh.com"
                    android:pathPrefix="/checkout/order-received/"/>
                <data
                    android:scheme="https"
                    android:host="alburagh.com"
                    android:pathPrefix="/checkout/order-received/"/>
            </intent-filter>
        </activity>
        <!-- image_cropper's native crop UI; without registering it here,
             launching the cropper throws ActivityNotFoundException. No
             screenOrientation lock: Google Play flags forced portrait as
             a large-screen restriction, and uCrop 2.2.11+ handles rotation
             and edge-to-edge insets itself. -->
        <activity
            android:name="com.yalantis.ucrop.UCropActivity"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar"/>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Required so url_launcher's canLaunchUrl() can find a browser for
             https links on Android 11+ (API 30) package-visibility rules.
             Without this, canLaunchUrl() silently returns false and the
             PayPal/card pay-for-order handoff never opens. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <category android:name="android.intent.category.BROWSABLE"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <category android:name="android.intent.category.BROWSABLE"/>
            <data android:scheme="http"/>
        </intent>
        <!-- Required so url_launcher's canLaunchUrl() can find a mail app
             for the product-detail share sheet's email option, same
             Android 11+ package-visibility reasoning as the https/http
             entries above. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="mailto"/>
        </intent>
    </queries>
</manifest>
